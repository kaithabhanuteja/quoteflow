# =============================================================
# QuoteFlow - Environment Variables Configuration
# =============================================================

# Flask Application Settings
SECRET_KEY=quoteflow-production-secret-key-change-in-prod
FLASK_DEBUG=True
PORT=5000

# Google Gemini API
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (MySQL / SQLAlchemy)
# If MySQL is configured and active, QuoteFlow connects to MySQL.
# Otherwise, it automatically and gracefully uses local SQLite fallback (quoteflow.db).
USE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=quoteflow_db

# Or direct database connection string:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/quoteflow_db

# Company Profile for Executive Quotation Letterhead
COMPANY_NAME=Quotflow Technologies Limited
COMPANY_ADDRESS=Madhapur, HITEC City, Hyderabad, Telangana, India
DEVELOPER_NAME=Kaitha Bhanuteja
DEFAULT_CURRENCY=INR
COMPANY_EMAIL=contact@quotflow.ai
COMPANY_WEBSITE=https://www.quotflow.ai
